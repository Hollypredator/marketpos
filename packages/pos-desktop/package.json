{
  "name": "@marketpos/pos-desktop",
  "version": "1.0.3",
  "private": true,
  "description": "MarketPOS Desktop POS Client",
  "author": "MarketPOS Team",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "assets:icon": "powershell -ExecutionPolicy Bypass -File ./scripts/generate-brand-icon.ps1",
    "build": "vite build",
    "build:web": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "lint": "npm run typecheck",
    "clean:electron-dev": "rimraf dist-electron",
    "clean-dev-compile": "rimraf dist-electron",
    "free-port:5175": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$p=(Get-NetTCPConnection -LocalPort 5175 -State Listen -ErrorAction SilentlyContinue | Select-Object -ExpandProperty OwningProcess -Unique); if($p){ $p | ForEach-Object { Stop-Process -Id $_ -Force -ErrorAction SilentlyContinue } }\"",
    "watch:electron": "tsc -p tsconfig.electron.json --watch --preserveWatchOutput",
    "electron:dev": "npm run free-port:5175 && npm run clean-dev-compile && concurrently -k -s first \"npm run dev -- --strictPort --port 5175\" \"npm run watch:electron\" \"wait-on http://localhost:5175 file:dist-electron/main.js file:dist-electron/preload.js && set \\\"ELECTRON_RUN_AS_NODE=\\\" && electron .\"",
    "electron:build": "npm run assets:icon && npm run build && npm run build:electron && electron-builder",
    "electron:release": "npm run electron:build && npm run release:manifest",
    "electron:release:signed": "npm run release:check-signing && npm run electron:release && npm run release:verify-signature",
    "release:check-signing": "powershell -ExecutionPolicy Bypass -File ./scripts/check-signing-env.ps1",
    "release:manifest": "node ./scripts/generate-release-manifest.mjs",
    "release:verify-signature": "powershell -ExecutionPolicy Bypass -File ./scripts/verify-release-signature.ps1",
    "clean": "rimraf dist dist-electron release",
    "test": "vitest run"
  },
  "dependencies": {
    "@marketpos/shared": "*",
    "better-sqlite3": "^11.8.0",
    "electron-updater": "^6.8.3",
    "node-thermal-printer": "^4.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.1.0",
    "electron": "33.3.0",
    "electron-builder": "^25.1.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.1.0",
    "vitest": "^4.1.2",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.marketpos.desktop",
    "publish": null,
    "artifactName": "MarketPOS-${version}-setup.${ext}",
    "productName": "MarketPOS",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "nsis": {
      "allowToChangeInstallationDirectory": false,
      "oneClick": false,
      "perMachine": false
    },
    "win": {
      "icon": "icon.ico",
      "signAndEditExecutable": true,
      "signtoolOptions": {
        "publisherName": "MarketPOS Team",
        "rfc3161TimeStampServer": "http://timestamp.digicert.com",
        "signingHashAlgorithms": [
          "sha256"
        ],
        "timeStampServer": "http://timestamp.digicert.com"
      },
      "verifyUpdateCodeSignature": true,
      "target": "nsis"
    }
  }
}
