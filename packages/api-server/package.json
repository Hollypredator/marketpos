{
  "name": "@marketpos/api-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "npm run typecheck",
    "test": "npm run build && node --import ./tests/register-loader.mjs tests/run-tests.mjs",
    "clean": "rimraf dist",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "npx tsx ../../prisma/seed.ts",
    "db:provision": "tsx ../../prisma/provision-company.ts",
    "db:backfill:money-minor": "tsx src/scripts/backfill-money-minor.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@fastify/jwt": "^9.0.0",
    "@fastify/static": "^10.1.3",
    "@marketpos/shared": "*",
    "@prisma/client": "^6.4.0",
    "@types/bcrypt": "^5.0.2",
    "@types/cheerio": "^0.22.35",
    "@types/node": "^22.0.0",
    "axios": "^1.15.0",
    "bcrypt": "^5.1.1",
    "cheerio": "^1.2.0",
    "fastify": "^5.2.0",
    "pg": "^8.20.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "pino-pretty": "^13.1.3",
    "prisma": "^6.4.0",
    "rimraf": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
