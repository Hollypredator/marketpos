{
  "name": "marketpos",
  "version": "1.0.0",
  "private": true,
  "description": "Market POS Yazarkasa Sistemi",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "start": "npx prisma db push --schema prisma/schema.prisma && npm run start --workspace @marketpos/api-server",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "repo:hygiene": "node ./scripts/check-generated-artifacts.mjs",
    "prisma:validate": "node ./scripts/prisma-validate.mjs",
    "prisma:migration:check": "node ./scripts/check-prisma-migration-guard.mjs",
    "clean": "turbo run clean",
    "desktop:signing:secrets": "powershell -ExecutionPolicy Bypass -File ./packages/pos-desktop/scripts/bootstrap-github-signing-secrets.ps1",
    "desktop:signing:check": "powershell -ExecutionPolicy Bypass -File ./packages/pos-desktop/scripts/check-github-signing-secrets.ps1",
    "desktop:signing:dispatch": "powershell -ExecutionPolicy Bypass -File ./packages/pos-desktop/scripts/dispatch-signed-release.ps1"
  },
  "devDependencies": {
    "turbo": "^2.4.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@10.0.0"
}
